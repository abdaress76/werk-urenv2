<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>My work hours</title>
<style>
:root{--bg:#f3f1ec;--card:#fff;--ink:#1d3a52;--mut:#6b7885;--line:#d9dde1;--work:#1d3a52;--leave:#2f7d5b;--hol:#b8741a;--sick:#a8403a;--tw:#6a5a9c;--on:#fff;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#10171d;--card:#18232c;--ink:#e6edf3;--mut:#93a1ad;--line:#2a3945;--work:#5b8db8;--leave:#4fae85;--hol:#d99a4a;--sick:#d4726b;--tw:#9b8bd0;--on:#0b1218}}
:root[data-theme="dark"]{--bg:#10171d;--card:#18232c;--ink:#e6edf3;--mut:#93a1ad;--line:#2a3945;--work:#5b8db8;--leave:#4fae85;--hol:#d99a4a;--sick:#d4726b;--tw:#9b8bd0;--on:#0b1218}
html{scroll-padding-top:env(safe-area-inset-top,0px)}*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.4 "Atkinson Hyperlegible",system-ui,-apple-system,"Segoe UI",sans-serif}
main{max-width:560px;margin:0 auto;padding:14px}h1{font-size:22px;margin:4px 0 12px}
.nav{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}.nav b{font-size:19px}
button,select,input,textarea{font:inherit;color:inherit}
.btn{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:8px 14px;cursor:pointer}
.box{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:12px;margin-bottom:12px}
.box h2{font-size:17px;margin:0 0 8px}
.tot{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.tot div{padding:6px 8px;border-left:4px solid var(--c,var(--line))}.tot small{display:block;color:var(--mut)}.tot strong{font-size:19px}
.wide{grid-column:1/-1}
.day{display:grid;grid-template-columns:54px 1fr 74px;gap:8px;align-items:center;padding:7px 0;border-bottom:1px solid var(--line)}
.day:last-child{border:0}.day.we{opacity:.6}.day .d{font-weight:700}.day .d small{display:block;font-weight:400;color:var(--mut)}
select,input[type=number],input[type=text],input[type=time],input[type=date]{width:100%;padding:8px;border-radius:8px;border:1px solid var(--line);background:var(--card)}
.row{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}label{display:block;color:var(--mut);font-size:14px;margin:6px 0 2px}
textarea{width:100%;height:70px;border:1px solid var(--line);border-radius:8px;background:var(--card);padding:8px}
.note{color:var(--mut);font-size:13px}
.clock{text-align:center}.clock .t{font-size:44px;font-weight:700;font-variant-numeric:tabular-nums;margin:2px 0 8px}.clock .row{justify-content:center}
.clock .btn{min-width:96px;padding:12px 16px;font-weight:700}.go{background:var(--leave)!important;color:var(--on)!important}
table{width:100%;border-collapse:collapse;font-variant-numeric:tabular-nums}th,td{padding:6px 4px;text-align:right;border-bottom:1px solid var(--line)}th:first-child,td:first-child{text-align:left}th{color:var(--mut);font-weight:400;font-size:14px}tfoot td{font-weight:700;border:0}
.diff{font-weight:700}.tm{grid-column:1/-1;display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px}.tm label{margin:0;font-size:12px}.pay td{font-size:13.5px;vertical-align:top}details summary{cursor:pointer;color:var(--mut);margin:6px 0}
</style></head><body><main>
<h1>My work hours</h1>

<div class="box clock"><b>Today</b><div id="bx" style="font-size:26px;font-weight:700;font-variant-numeric:tabular-nums"></div><div class="note" id="bd"></div><div class="t" id="clk">00:00:00</div><div class="note" id="cst"></div>
<div style="margin:8px 0"><select id="brsel"></select></div>
<div class="row"><button class="btn go" id="pp">▶ Start</button><button class="btn" id="fin">■ Finish day</button><button class="btn" id="rst">Reset</button></div>
<details style="text-align:left"><summary>Forgot to start? Enter your times</summary><label>Date</label><input type="date" id="fd"><div class="tm"><div><label>Start</label><input type="time" id="fs"></div><div><label>End</label><input type="time" id="fe"></div><div><label>Break min</label><input type="number" min="0" id="fb" placeholder="auto"></div></div><div class="row"><button class="btn go" id="fsv">Save these times</button></div></details></div>

<div class="nav"><button class="btn" id="prev">‹</button><b id="mt"></b><button class="btn" id="next">›</button></div>

<div class="box"><h2>This month</h2><div class="tot" id="tot"></div>
<div class="row"><button class="btn" id="fill">Fill weekdays as work</button><button class="btn" id="cpy">Copy month summary</button><button class="btn" id="clr">Clear month</button></div></div>

<div class="box" id="days"></div>

<div class="box"><h2>All months</h2><div id="ov"></div></div>

<div class="box"><h2>Payslip (estimate)</h2><div id="ps"></div>
<div class="row"><button class="btn" id="pcp">Copy payslip as text</button></div>
<h2 style="margin-top:14px;font-size:15px">Extra lines this month</h2><div class="note">For example flex, foreign allowance, advance, fine.</div>
<div class="tm" style="grid-template-columns:2fr 1fr 1fr;margin-top:6px"><input type="text" id="xn" placeholder="Name"><input type="number" step="0.01" id="xa" placeholder="€"><select id="xk"><option value="t">Gross +</option><option value="u">Untaxed +</option><option value="d">Deduction -</option></select></div>
<div class="row"><button class="btn" id="xadd">Add line</button></div><div id="xls"></div>
<label>Work bonus ONSS reduction (€), from payslip</label><input type="number" step="0.01" id="pb"><label>Withholding tax (€), from payslip, optional</label><input type="number" step="0.01" id="ppo"></div>

<div class="box"><h2>Check with my payslip</h2><div class="note">Fill in what your loonfiche says for this month.</div>
<label>Hours on payslip</label><input type="number" step="0.01" id="sh"><label>Net pay on payslip (€)</label><input type="number" step="0.01" id="sn"><div id="sd" style="margin-top:8px"></div></div>

<div class="box"><h2>Settings</h2>
<label>Hours per full day</label><input type="number" step="0.01" id="dh">
<label>Gross hourly wage (€)</label><input type="number" step="0.01" id="wage">
<label>Automatic break (minutes)</label><input type="number" step="1" min="0" id="br">
<label>Income tax withholding (%) for the estimate</label><input type="number" step="0.1" min="0" id="tax">
<label>Vacation days you have this year</label><input type="number" step="1" min="0" id="vd"><label>Transport allowance per worked day (€)</label><input type="number" step="0.0001" min="0" id="tr"><label>Chômage supplement per day (€)</label><input type="number" step="0.01" min="0" id="cs">
<p class="note">Estimates only. Worker rules used: social security 13,07% on 108% of gross; overtime +50% Mon-Sat and +100% on Sundays. Holiday pay comes separately from the holiday fund and is not in these numbers. Your real payslip always wins.</p></div>

<div class="box"><h2>Backup</h2>
<div class="row" style="margin-top:0"><button class="btn" id="exp">Copy my data</button><button class="btn" id="imp">Restore from text</button></div>
<textarea id="bk" placeholder="Paste backup text here to restore"></textarea>
<p class="note">Data is saved on this phone, in this browser. Copy a backup now and then.</p></div>
</main>
<script>
const T={W:{n:"Work (100)",c:"--work"},L:{n:"Vacation / legal leave (230)",c:"--leave"},H:{n:"Holiday replacement (2205)",c:"--hol"},S:{n:"Sick (ziekte)",c:"--sick"},U:{n:"Chômage (temp. unemployment)",c:"--tw"},O:{n:"Off / nothing",c:"--line"}};
const KEY="werkuren-v1";
let S={days:{},dh:7.6,wage:0,br:30,tax:20,vd:20,slip:{}},cur=new Date();cur.setDate(1);
try{const r=localStorage.getItem(KEY);if(r)S=Object.assign(S,JSON.parse(r))}catch(e){}
S.slip=S.slip||{};if(S.tax===20)S.tax=11;
const save=()=>{try{localStorage.setItem(KEY,JSON.stringify(S))}catch(e){}};
const $=i=>document.getElementById(i),f=n=>(Math.round(n*100)/100).toFixed(2).replace(".",","),p2=n=>String(n).padStart(2,"0");
const ym=()=>cur.getFullYear()+"-"+p2(cur.getMonth()+1),dim=()=>new Date(cur.getFullYear(),cur.getMonth()+1,0).getDate();
const DN=["Sun","Mon","Tue","Wed","Thu","Fri","Sat"],BR=()=>S.br==null?30:S.br;
const eur=n=>"€"+f(n);

function calc(m){
 const r={n:0,x:0,xs:0,L:0,H:0,S:0,U:0,b:0,dn:0,dl:0,ds:0};
 for(const k in S.days){if(k.slice(0,7)!=m)continue;const e=S.days[k],h=+e.h||0,w=new Date(k+"T12:00:00").getDay();
  if(e.t=="W"){r.n+=Math.min(h,S.dh);const x=Math.max(0,h-S.dh);if(w==0)r.xs+=x;else r.x+=x;r.b+=e.b||0;r.dn++}
  else if(e.t=="L"){r.L+=h;r.dl++}else if(e.t=="H")r.H+=h;else if(e.t=="S"){r.S+=h;r.ds++}else if(e.t=="U")r.U++}
 r.ex=r.x+r.xs;r.paid=r.n+r.ex+r.L+r.H+r.S;
 const W=S.wage||0;money(r,m);
 return r}

function render(){
 const m=ym(),r=calc(m);
 $("mt").textContent=cur.toLocaleDateString("en-GB",{month:"long",year:"numeric"});
 $("dh").value=S.dh;$("wage").value=S.wage||"";$("br").value=BR();$("tax").value=S.tax;$("vd").value=S.vd;$("tr").value=S.tr||"";$("cs").value=S.cs||"";
 const v=$("brsel").value;$("brsel").innerHTML='<option value="auto">Break taken (-'+BR()+' min)</option><option value="none">No break today</option>';if(v)$("brsel").value=v;
 let box="";
 for(let d=1;d<=dim();d++){
  const k=m+"-"+p2(d),w=new Date(cur.getFullYear(),cur.getMonth(),d).getDay(),e=S.days[k]||{t:"O",h:0};
  box+=`<div class="day ${w==0||w==6?"we":""}"><div class="d">${d}<small>${DN[w]}</small></div>
  <select data-k="${k}" class="t" style="border-left:5px solid var(${T[e.t].c})">${Object.keys(T).map(x=>`<option value="${x}" ${x==e.t?"selected":""}>${T[x].n}</option>`).join("")}</select>
  <input type="number" step="0.01" min="0" max="24" data-k="${k}" class="h" value="${e.h||""}" placeholder="hrs">${e.t=="W"?`<div class="tm"><div><label>Start</label><input type="time" data-k="${k}" class="s" value="${e.s||""}"></div><div><label>End</label><input type="time" data-k="${k}" class="e" value="${e.e||""}"></div><div><label>Break min</label><input type="number" min="0" data-k="${k}" class="b" value="${e.b==null?"":e.b}" placeholder="${BR()}"></div></div>`:""}</div>`}
 $("days").innerHTML=box;
 const c=(l,v,col,w)=>`<div class="${w?"wide":""}" style="--c:var(${col})"><small>${l}</small><strong>${v}</strong></div>`;
 const yr=cur.getFullYear();let used=0;for(const x in S.days)if(x.slice(0,4)==yr&&S.days[x].t=="L")used++;
 $("tot").innerHTML=c("Normal hours",f(r.n)+" h ("+r.dn+" days)","--work")+c("Extra hours",f(r.ex)+" h","--hol")
  +c("Vacation",f(r.L)+" h ("+r.dl+" days)","--leave")+c("Holiday replacement",f(r.H)+" h","--hol")
  +c("Sick days",f(r.S)+" h ("+r.ds+")","--sick")+c("Chômage days",r.U+" days","--tw")
  +c("Total paid hours",f(r.paid)+" h","--ink",1)
  +c("Breaks taken",r.b+" min","--mut")+c("Vacation days left "+yr,Math.max(0,S.vd-used)+" of "+S.vd,"--leave")
  +(S.wage?c("Gross (estimate)",eur(r.gross),"--ink")+c("Social security",'-'+eur(r.rsz),"--mut")+c("Tax withholding",'-'+eur(r.tx),"--mut")+c("Net (estimate)",eur(r.net),"--leave")
   +(r.ex?`<div class="wide note">Extra hours pay: ${f(r.x)} h at +50%${r.xs?`, ${f(r.xs)} h on Sunday at +100%`:""}.</div>`:""):`<div class="wide note">Add your hourly wage in Settings for a pay estimate.</div>`);
 const ms=[...new Set(Object.keys(S.days).map(k=>k.slice(0,7)))].sort().reverse(),G={n:0,x:0,p:0};
 const rows=ms.map(x=>{const q=calc(x);G.n+=q.n;G.x+=q.ex;G.p+=q.paid;return`<tr><td>${x}</td><td>${f(q.n)}</td><td>${f(q.ex)}</td><td>${f(q.paid)}</td></tr>`}).join("");
 $("ov").innerHTML=ms.length?`<table><thead><tr><th>Month</th><th>Normal</th><th>Extra</th><th>Total</th></tr></thead><tbody>${rows}</tbody><tfoot><tr><td>All</td><td>${f(G.n)}</td><td>${f(G.x)}</td><td>${f(G.p)}</td></tr></tfoot></table>`:'<div class="note">Nothing saved yet.</div>';
 const sl=S.slip[m]||{};$("sh").value=sl.h||"";$("sn").value=sl.n||"";
 let sd="";if(sl.h)sd+=`Hours: app ${f(r.paid)} vs payslip ${f(sl.h)} → <span class="diff">${f(sl.h-r.paid)} h</span><br>`;
 if(sl.n&&S.wage)sd+=`Net: estimate ${eur(r.net)} vs payslip ${eur(sl.n)} → <span class="diff">${eur(sl.n-r.net)}</span>`;
 $("sd").innerHTML=sd||'<span class="note">Nothing to compare yet.</span>';
 const pv=(S.pm&&S.pm[m])||{};$("pb").value=pv.b||"";$("ppo").value=pv.pp==null?"":pv.pp;
 $("xls").innerHTML=xl(m).map((e,i)=>`<div class="row" style="justify-content:space-between;align-items:center;margin:4px 0"><span>${e.l} (${e.k=="t"?"gross +":e.k=="u"?"untaxed +":"deduction -"}) ${eur(e.a)}</span><button class="btn" data-del="${i}">✕</button></div>`).join("");
 $("ps").innerHTML=`<table class="pay"><thead><tr><th>Description</th><th>Hours</th><th>€</th></tr></thead><tbody>${slipRows(r).map(x=>`<tr style="${x[3]?"font-weight:700":""}"><td>${x[0]}</td><td>${x[1]}</td><td>${x[2]}</td></tr>`).join("")}</tbody></table><details><summary>Daily data (hours and codes)</summary>${daily()}</details>`}

$("days").addEventListener("change",ev=>{const k=ev.target.dataset.k;if(!k)return;
 const e=S.days[k]||(S.days[k]={t:"O",h:0});
 const c=ev.target.classList,v=ev.target.value;
 if(c.contains("t")){e.t=v;e.b=null;e.s=e.e="";e.h="WLHS".includes(e.t)?S.dh:0}
 else if(c.contains("h"))e.h=parseFloat(v)||0;
 else{if(c.contains("s"))e.s=v;if(c.contains("e"))e.e=v;if(c.contains("b"))e.b=v===""?null:parseFloat(v);autoH(e)}
 save();render()});
$("prev").onclick=()=>{cur.setMonth(cur.getMonth()-1);render()};$("next").onclick=()=>{cur.setMonth(cur.getMonth()+1);render()};
$("fill").onclick=()=>{for(let d=1;d<=dim();d++){const k=ym()+"-"+p2(d),w=new Date(cur.getFullYear(),cur.getMonth(),d).getDay();if(w>0&&w<6&&!S.days[k])S.days[k]={t:"W",h:S.dh}}save();render()};
$("clr").onclick=()=>{if(!confirm("Clear all days of this month?"))return;for(let d=1;d<=dim();d++)delete S.days[ym()+"-"+p2(d)];save();render()};
const num=(id,key,def)=>{$(id).onchange=()=>{const x=parseFloat($(id).value);S[key]=isNaN(x)?def:x;save();render()}};
num("dh","dh",7.6);num("wage","wage",0);num("br","br",30);num("tax","tax",11);num("vd","vd",20);num("tr","tr",0);num("cs","cs",0);
const sv=()=>{S.slip[ym()]={h:parseFloat($("sh").value)||0,n:parseFloat($("sn").value)||0};save();render()};$("sh").onchange=sv;$("sn").onchange=sv;
async function copy(t,b,ok){try{await navigator.clipboard.writeText(t);b.textContent=ok}catch(e){$("bk").value=t;$("bk").select();b.textContent="Select and copy the text"}}
$("cpy").onclick=()=>{const r=calc(ym());copy(`${$("mt").textContent}\nNormal hours: ${f(r.n)}\nExtra hours: ${f(r.ex)}\nVacation: ${f(r.L)} h (${r.dl} days)\nHoliday replacement: ${f(r.H)} h\nSick: ${f(r.S)} h (${r.ds} days)\nChômage: ${r.U} days\nTotal paid hours: ${f(r.paid)}`,$("cpy"),"Copied")};
$("exp").onclick=()=>{const t=JSON.stringify(S);$("bk").value=t;copy(t,$("exp"),"Copied")};
$("imp").onclick=()=>{try{const o=JSON.parse($("bk").value);if(!o.days)throw 0;S=Object.assign({days:{},dh:7.6,wage:0,br:30,tax:20,vd:20,slip:{}},o);save();render();$("imp").textContent="Restored"}catch(e){$("imp").textContent="Invalid text"}};

const TM=S.timer=S.timer||{run:false,start:0,acc:0};
const el=()=>TM.acc+(TM.run?Date.now()-TM.start:0);
function tick(){const B=bxl();$("bx").textContent=B.s;$("bd").textContent=B.date+" - Belgium (Brussels time)";const s=Math.floor(el()/1000);$("clk").textContent=p2(Math.floor(s/3600))+":"+p2(Math.floor(s/60)%60)+":"+p2(s%60);
 $("pp").textContent=TM.run?"Counting...":"▶ Start";$("pp").disabled=TM.run;
 $("cst").textContent=TM.run?"Counting your day. Press Finish day when you are done.":"Press Start when you begin work."}
const bxl=(t=new Date())=>{const o={};new Intl.DateTimeFormat("en-GB",{timeZone:"Europe/Brussels",hourCycle:"h23",year:"numeric",month:"2-digit",day:"2-digit",hour:"2-digit",minute:"2-digit",second:"2-digit"}).formatToParts(t).forEach(x=>o[x.type]=x.value);return{date:o.year+"-"+o.month+"-"+o.day,hm:o.hour+":"+o.minute,s:o.hour+":"+o.minute+":"+o.second,y:+o.year,m:+o.month}};
const dk=n=>n.getFullYear()+"-"+p2(n.getMonth()+1)+"-"+p2(n.getDate()),hm=t=>{const[a,b]=t.split(":");return +a*60+ +b},xl=m=>(S.xl&&S.xl[m])||[],FD=["di","lu","ma","me","je","ve","sa"];
function autoH(e){if(!e.s||!e.e)return;let d=hm(e.e)-hm(e.s);if(d<0)d+=1440;const b=e.b==null?BR():e.b;e.b=b;e.h=Math.max(0,Math.round((d-b)/60*100)/100)}
function money(r,m){const W=S.wage||0,o=(S.pm&&S.pm[m])||{},E=xl(m),sm=k=>E.filter(e=>e.k==k).reduce((a,e)=>a+e.a,0);
 r.ext=E;r.base=r.n*W;r.xpay=(1.5*r.x+2*r.xs)*W;r.hpay=r.H*W;r.spay=r.S*W;r.trans=r.dn*(S.tr||0);r.chs=r.U*(S.cs||0);
 r.gross=r.base+r.xpay+r.hpay+r.spay+sm("t");r.onss=r.gross*1.08*.1307;r.bonus=o.b||0;r.rsz=r.onss-r.bonus;
 r.imp=r.gross-r.rsz+r.chs;r.pp=o.pp!=null?o.pp:r.imp*(S.tax||0)/100;r.tx=r.pp;r.sub=r.imp-r.pp;r.net=r.sub+sm("u")+r.trans-sm("d")}
function slipRows(r){const W=S.wage||0,z=[],L=(c,l,q,a,b)=>z.push([(c?c+" ":"")+l,q===""?"":f(q),a===""?"":f(a),b]);
 L("100","prestations ordinaires ("+r.dn+" days × "+f(W)+" €/h)",r.n,r.base);
 if(r.ex)L("","extra hours (+50%, Sunday +100%)",r.ex,r.xpay);
 if(r.H)L("2205","remplacement jour férié légal",r.H,r.hpay);
 if(r.S)L("","sick days (estimate)",r.S,r.spay);
 r.ext.forEach(e=>{if(e.k=="t")L("",e.l,"",e.a)});
 L("****","TOTAL BRUT","",r.gross,1);
 L("9000","ONSS travailleur 13,07% on 108%","",-r.onss);
 if(r.bonus)L("9052","ONSS work bonus reduction","",r.bonus);
 if(r.U){L("371","chômage économique ("+r.U+" days)",r.U*S.dh,"");if(r.chs)L("3701","indemnité pour chômage","",r.chs)}
 L("****","TOTAL IMPOSABLE","",r.imp,1);
 L("9200","précompte professionnel","",-r.pp);
 L("****","SOUSTOTAL","",r.sub,1);
 if(r.trans)L("9420","transport non imposé ("+r.dn+" days)","",r.trans);
 r.ext.forEach(e=>{if(e.k!="t")L("",e.l,"",e.k=="u"?e.a:-e.a)});
 L("****","NET À PAYER","",r.net,1);return z}
function daily(){let s="";for(let d=1;d<=dim();d++){const k=ym()+"-"+p2(d),w=new Date(cur.getFullYear(),cur.getMonth(),d).getDay(),e=S.days[k];let a=["","","","",""];
 if(e){const t=e.s?e.s+"-"+(e.e||"..."):"";if(e.t=="W")a=[f(e.h),"100","","",t];else if("LHSU".includes(e.t))a=["0,00","100",f(e.t=="U"?S.dh:e.h),{L:"230",H:"2205",S:"S",U:"371"}[e.t],""]}
 s+=`<tr><td>${FD[w]} ${p2(d)}</td><td>${a[0]}</td><td>${a[1]}</td><td>${a[2]}</td><td>${a[3]}</td><td>${a[4]}</td></tr>`}
 return`<table><thead><tr><th>Day</th><th>Hours</th><th>Code</th><th>Hours</th><th>Code</th><th>Time</th></tr></thead><tbody>${s}</tbody></table>`}
$("xadd").onclick=()=>{const l=$("xn").value.trim(),a=parseFloat($("xa").value);if(!l||isNaN(a))return;S.xl=S.xl||{};(S.xl[ym()]=S.xl[ym()]||[]).push({l,a,k:$("xk").value});$("xn").value=$("xa").value="";save();render()};
$("xls").onclick=ev=>{const i=ev.target.dataset.del;if(i==null)return;xl(ym()).splice(+i,1);save();render()};
