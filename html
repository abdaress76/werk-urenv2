 if(!confirm("Save "+f(net)+" h worked today"+(bm?" ("+bm+" min break taken off)":" (no break)")+"?"))return;
 {const d=S.days[k]||{};S.days[k]={t:"W",s:d.s||bxl(new Date(Date.now()-ms)).hm,e:B.hm,h:net,b:bm}}TM.run=false;TM.acc=0;TM.start=0;save();cur=new Date(B.y,B.m-1,1);render();tick()};
